{
  "version": 1,
  "updated_at": "2026-09-04",
  "purpose": "金标回归集 (闭环 v2 防线①): 十几轮闭环的每个历史修复 case 永久固化。任何词表/阈值/路由改动跑本集, 破一条即挡 — 终结'修 A 破 B 无人知'的打地鼠模式。断言分层: intent(分类) / route(链路选择) / gate(门判定)。",
  "cases": [
    {
      "id": "qa1-loss-wallet-stolen",
      "origin": "qa_scan 首轮 FAQ 劫持",
      "layer": "intent",
      "input": "钱包被偷了, 卡也在里面",
      "assert": {
        "intent": "CARD_LOSS",
        "min_conf": 0.9,
        "emergency_faq_exempt": true
      }
    },
    {
      "id": "qa4-loss-cant-find",
      "origin": "qa_scan 第四轮 两次没理解",
      "layer": "intent",
      "input": "信用卡找不到了, 怎么办呢",
      "assert": {
        "intent": "CARD_LOSS",
        "min_conf": 0.9,
        "consultative": true
      }
    },
    {
      "id": "qa8-loss-stolen-boost",
      "origin": "第八轮 同意图置信提升",
      "layer": "intent",
      "input": "卡好像被盗了, 赶紧给我停了",
      "assert": {
        "intent": "CARD_LOSS",
        "min_conf": 0.8
      }
    },
    {
      "id": "qa9-loss-direct-imperative",
      "origin": "第九轮 直连边界",
      "layer": "route",
      "input": "我的卡丢了, 帮我挂失",
      "assert": {
        "intent": "CARD_LOSS",
        "direct_tool": true
      }
    },
    {
      "id": "qa9-loss-consultative-bypass",
      "origin": "第九轮 咨询句式豁免",
      "layer": "route",
      "input": "信用卡挂失流程是什么",
      "assert": {
        "consultative": true,
        "direct_tool": false
      }
    },
    {
      "id": "sess8700-poem-chitchat",
      "origin": "会话 8700a2ea 闲聊入 RAG",
      "layer": "gate",
      "input": "锄禾日当午",
      "assert": {
        "chitchat_capped": true,
        "max_conf": 0.29
      }
    },
    {
      "id": "sess9ed5-nonsense-query",
      "origin": "会话 9ed55603 三层击穿",
      "layer": "gate",
      "input": "查看开发",
      "assert": {
        "retrieval_miss": true
      }
    },
    {
      "id": "sess9ed5-generic-verb-still-works",
      "origin": "同上修复的误伤防线",
      "layer": "gate",
      "input": "查看账单",
      "assert": {
        "retrieval_hit_business": "账单"
      }
    },
    {
      "id": "qa5-definition-to-knowledge",
      "origin": "第五轮 定义句式拦截",
      "layer": "route",
      "input": "什么是临时额度",
