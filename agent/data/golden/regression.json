        "definition": true,
        "knowledge_chain": true
      }
    },
    {
      "id": "qa5-personal-query-not-hijacked",
      "origin": "第五轮 防截胡",
      "layer": "gate",
      "input": "我的额度是什么",
      "assert": {
        "personal_query": true,
        "faq_semantic_blocked": true
      }
    },
    {
      "id": "qa5-faq-exact-with-particle",
