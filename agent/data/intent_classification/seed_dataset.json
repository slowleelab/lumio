  "labels": [
    {
      "id": "faq",
      "name_zh": "通用知识问答",
      "definition": "信用卡通用政策/流程/规则常识咨询（年费、免息期、账单日、汇率、激活、提醒等），不指向单条账单或单笔交易的查询，也不含业务办理动作。",
      "decision_path": "knowledge (RAG)",
      "note": "覆盖面最广的类，靠 RAG 检索回答；易与业务意图的\"时效/办理\"问法混淆。"
    },
    {
      "id": "bill_query",
      "name_zh": "账单查询",
      "definition": "针对账单整体或还款额的查询（本期/历史账单、应还/最低还款、欠款总额）。",
      "decision_path": "knowledge (RAG 降级路由; progressive_disclosure 开启且有工具时改走 MCP 工具编排)",
      "note": "问\"总额/还款额\"归此；问\"逐笔明细\"归 transaction_query。"
    },
    {
      "id": "transaction_query",
      "name_zh": "交易明细查询",
      "definition": "针对具体逐笔消费/扣款/流水的查询（某笔金额、时间、商户、入账状态）。",
      "decision_path": "knowledge (RAG 降级路由; progressive_disclosure 开启且有工具时改走 MCP 工具编排)",
      "note": "与 bill_query 是头号易混淆对，靠\"总额 vs 逐笔\"区分。"
    },
    {
      "id": "limit_query",
      "name_zh": "额度查询/额度管理",
      "definition": "额度相关查询或操作诉求（当前/可用/临时额度、提额/降额）。",
      "decision_path": "knowledge (RAG 降级路由; progressive_disclosure 开启且有工具时改走 MCP 工具编排)",
      "note": "仅做意图识别；提额/降额属敏感操作走确认状态机。"
    },
    {
      "id": "installment_inquiry",
      "name_zh": "分期咨询/办理",
      "definition": "分期相关咨询或办理（账单/消费分期、期数、手续费率、提前还款）。",
      "decision_path": "knowledge (RAG 降级路由; progressive_disclosure 开启且有工具时改走 MCP 工具编排)",
      "note": "问\"手续费怎么收\"倾向此意图，即便含\"费率\"措辞。"
    },
    {
      "id": "reward_query",
      "name_zh": "积分/权益查询",
      "definition": "信用卡积分或权益相关（积分余额/兑换/过期、积分商城、权益到账）。",
      "decision_path": "knowledge (RAG 降级路由; progressive_disclosure 开启且有工具时改走 MCP 工具编排)",
      "note": "涉及积分的时效/兑换均归此，非通用 FAQ。"
    },
    {
      "id": "card_loss",
      "name_zh": "挂失/补卡",
      "definition": "卡片丢失/被盗、要求挂失止付、补卡换卡。全站唯一敏感写意图。",
      "decision_path": "business (敏感, 需确认/转人工)",
      "note": "命中即高优先级，不可误分流到 faq；需客户确认，必要时转人工核实身份。"
    },
    {
      "id": "complaint",
      "name_zh": "投诉",
      "definition": "表达不满/投诉意图（服务态度、乱扣费、处理结果不满意），通常伴随负面情绪。",
      "decision_path": "business (投诉处理)",
      "note": "即使抱怨的是某项明细，优先判 complaint 而非 transaction_query。"
    },
    {
      "id": "transfer_agent",
      "name_zh": "转人工",
      "definition": "明确要求人工/真人客服介入。",
      "decision_path": "transfer (转人工会话)",
      "note": "诉求重点是\"找人工\"→此意图；诉求重点是\"办某事\"（如挂失）则归对应业务意图。"
    },
    {
      "id": "chitchat",
      "name_zh": "闲聊/非业务",
      "definition": "问候/寒暄/非业务表达，封闭集内其余内容通常落入此类作为兜底。",
      "decision_path": "fallback (模板/joke)",
      "note": "承担封闭集外溢出；但\"你好\"+业务诉求混合时需靠分类器判主诉求。"
    }
  ],
