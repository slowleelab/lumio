    "taxonomy": "IntentLabel (封闭 10 类单标签分类)",
    "version": "0.3.2",
    "domain": "银行信用卡客服",
    "purpose": "BERT 系轻量意图分类器微调的首批种子数据；标签口径与 RuleClassifier(_RULES) 对齐; decision_path 与运行时 INTENT_DOMAINS 降级路由对齐(查询类=knowledge)",
    "source": "rule-aligned seeds + 人工撰写",
    "counts": {
      "examples": 191,
      "confusable_pairs": 15
    }
